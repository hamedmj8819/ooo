@echo off
chcp 65001 > nul
title سامانه MES کارخانه ساخت کمپرسور و بلوئر - سرور شبکه محلی (LAN)

echo ======================================================================
echo    سامانه یکپارچه برنامه‌ریزی و مدیریت تولید (MES) - نسخه آفلاین
echo    ویژه خطوط ساخت کمپرسور اسکرو و بلوئر روتس (لوپ‌تایپ)
echo ======================================================================
echo.
echo در حال راه‌اندازی سرور داخلی بر روی شبکه محلی کارخانه (LAN)...
echo سرور بر روی پورت 3000 اجرا شده و سایر رایانه‌ها می‌توانند از طریق IP این سیستم متصل شوند.
echo.

if not exist node_modules (
    echo در حال نصب پیش‌نیازها...
    call npm install
)

echo سرور با موفقیت در حال آماده‌سازی است...
echo برای ورود به برنامه مرورگر را باز کرده و به آدرس زیر بروید:
echo http://localhost:3000
echo.
call npm run dev
pause
